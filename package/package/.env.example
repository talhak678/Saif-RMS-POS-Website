# Environment Variables for Saif RMS Website

# Restaurant Slug - This determines which restaurant's data to fetch
# IMPORTANT: This must match the 'slug' field of your restaurant in the database
# Default: saifs-kitchen
VITE_RESTAURANT_SLUG=saifs-kitchen

# API Base URL (production backend)
VITE_API_URL=https://saif-rms-pos-backend.vercel.app

